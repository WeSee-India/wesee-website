# ── Database ───────────────────────────────────────────────────────────
# Local: `docker compose up -d db` (from the repo root) gives you this database.
# Production: Railway Postgres; set it to the reference ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgresql://wesee:wesee@localhost:5435/wesee

# ── Server ─────────────────────────────────────────────────────────────
PORT=4000
# Public website origin: used for preview links.
SITE_URL=http://localhost:3000
# Browser origins allowed to call the API with credentials (comma-separated).
# Production: https://www.weseegpt.com,https://weseegpt.com,https://admin.weseegpt.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
ADMIN_URL=http://localhost:3001

# ── Sessions ───────────────────────────────────────────────────────────
# REQUIRED in production: 32+ random characters, e.g. `openssl rand -base64 48`.
SESSION_SECRET=
SESSION_TTL_HOURS=12
# lax when admin and API share a site (same origin, or admin.weseegpt.com + api.weseegpt.com).
# none only if they are on unrelated domains (also requires HTTPS).
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
TRUST_PROXY=1

# ── Media uploads (local disk) ─────────────────────────────────────────
# Production on Railway: point this at the volume mount, e.g. /data/uploads
# UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=10

# ── Rebuild the public site after publishing (optional) ────────────────
# A Vercel deploy hook URL for the client project; refreshes prerendered SEO pages.
# CLIENT_DEPLOY_HOOK_URL=
DEPLOY_HOOK_DEBOUNCE_SECONDS=60

# ── Contact form (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=
CONTACT_TO=harsh.khanna@weseegpt.com
# Until weseegpt.com is verified in Resend, leave unset to use the Resend test sender.
# RESEND_FROM="WeSee Contact Form <noreply@weseegpt.com>"

# ── Seeding ────────────────────────────────────────────────────────────
# First owner account created by `pnpm db:seed` (only if no users exist).
SEED_OWNER_EMAIL=
SEED_OWNER_NAME=
SEED_OWNER_PASSWORD=
