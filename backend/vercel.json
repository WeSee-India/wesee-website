{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build && pnpm db:deploy && pnpm db:seed",
  "outputDirectory": "public",
  "regions": ["sin1"],
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
