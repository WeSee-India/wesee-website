# ── Contact form (Resend) ──────────────────────────────────────────────
# The contact form (api/contact.ts) sends notification emails via Resend.
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Where contact-form (discovery call) submissions are delivered — business leads
CONTACT_TO=harsh.khanna@weseegpt.com

# From address for notification emails. Until weseegpt.com is verified in Resend,
# leave this UNSET to fall back to the Resend test sender (onboarding@resend.dev).
# Once the domain is verified in Resend, set e.g.:
# RESEND_FROM="WeSee Contact Form <noreply@weseegpt.com>"

# ── Floating WhatsApp / Call widget (GlobalConnectWidget) ───────────────
# Without these the connect widget silently hides itself in production.
VITE_WHATSAPP_PHONE=
VITE_WHATSAPP_MESSAGE=

# ── Optional: Umami analytics ───────────────────────────────────────────
# Only needed if you re-add the analytics <script> to client/index.html.
# VITE_ANALYTICS_ENDPOINT=
# VITE_ANALYTICS_WEBSITE_ID=
