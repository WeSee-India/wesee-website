# ── API ────────────────────────────────────────────────────────────────
# Origin of the backend (backend/). Leave empty in development: Vite proxies
# /api and /uploads to VITE_API_PROXY_TARGET (default http://localhost:4000).
# Production: https://api.weseegpt.com (or the Railway service URL).
VITE_API_URL=
# VITE_API_PROXY_TARGET=http://localhost:4000

# Used at BUILD time to fetch published content for the prerendered SEO pages
# and the bundled content snapshot. Defaults to VITE_API_URL. If the API is
# unreachable the build falls back to the seed content (set CONTENT_STRICT=1
# to fail the build instead; recommended for production).
# CONTENT_API_URL=
# CONTENT_STRICT=1

# ── Floating WhatsApp / Call widget (fallback) ─────────────────────────
# Now managed in Admin → Settings → Contact details. These are only used when
# those settings are empty.
VITE_WHATSAPP_PHONE=
VITE_WHATSAPP_MESSAGE=

# ── Optional: Umami analytics ───────────────────────────────────────────
# Only needed if you re-add the analytics <script> to client/index.html.
# VITE_ANALYTICS_ENDPOINT=
# VITE_ANALYTICS_WEBSITE_ID=
