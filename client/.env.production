# Production build settings (public values only; this file is committed).
# Without VITE_API_URL the site asks its own domain for /api/public/snapshot, gets the
# HTML page back, and silently keeps the content bundled at build time, so edits made
# in the admin never appear. A value set in the hosting dashboard overrides this one.
VITE_API_URL=https://cms-api.weseegpt.com
