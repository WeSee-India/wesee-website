{
  "name": "weseegpt-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @wesee/backend --filter @wesee/client --filter @wesee/admin dev",
    "dev:client": "pnpm --filter @wesee/client dev",
    "dev:admin": "pnpm --filter @wesee/admin dev",
    "dev:backend": "pnpm --filter @wesee/backend dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @wesee/backend db:migrate",
    "db:deploy": "pnpm --filter @wesee/backend db:deploy",
    "db:seed": "pnpm --filter @wesee/backend db:seed",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "pnpm": {
    "patchedDependencies": {
      "wouter@3.7.1": "patches/wouter@3.7.1.patch"
    },
    "overrides": {
      "tailwindcss>nanoid": "3.3.7"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@node-rs/argon2",
      "sharp"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
